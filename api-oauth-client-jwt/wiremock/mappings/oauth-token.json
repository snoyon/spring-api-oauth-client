{
  "request": {
    "method": "POST",
    "urlPath": "/oauth/token",
    "bodyPatterns": [
      {
        "contains": "grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Ajwt-bearer"
      },
      {
        "matches": ".*assertion=[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+.*"
      },
      {
        "contains": "scope=person.read"
      },
      {
        "doesNotContain": "client_id="
      },
      {
        "doesNotContain": "client_secret="
      }
    ]
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "access_token": "token-123",
      "token_type": "Bearer",
      "expires_in": 300
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
